# Optional: canonical site URL for Open Graph (set this in production)
NEXT_PUBLIC_APP_URL=http://localhost:3000
AUTH_SECRET=****

# https://platform.openai.com/api-keys
OPENAI_API_KEY=****

# Postgres (e.g. Neon) — chat history and users
POSTGRES_URL=****

# Optional: object storage for uploaded files
BLOB_READ_WRITE_TOKEN=****

# Optional: Redis for rate limiting
REDIS_URL=****

# Databricks Genie Agent (server-side only)
# Host example: https://adb-xxxxxxxxxxxx.azuredatabricks.net
DATABRICKS_HOST=****
DATABRICKS_TOKEN=****
DATABRICKS_GENIE_AGENT_ID=****
